# Copy this file to .env.local and fill in the values for local WooCommerce testing.

PORT=4545

# Paste your OpenAI API key here for local testing.
OPENAI_API_KEY=

# These must match the values saved in WooCommerce > AI Assistant.
WOO_ASSISTANT_SITE_ID=faf437e2-a045-4b7a-8d23-0b67860e6e65
WOO_ASSISTANT_SITE_SECRET=local-test-secret-123456789
